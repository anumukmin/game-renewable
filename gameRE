<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Kecamatan Harapan - Ekspedisi Energi Terbarukan 3D</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100dvh;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            touch-action: manipulation;
        }
        #canvas-container {
            width: 100%;
            height: 100%;
            display: block;
            touch-action: none;
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }
        .dpad-btn {
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.45); }
            50% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
        }
        .pulse-glow { animation: pulseGlow 2s infinite; }
    </style>
</head>
<body class="text-slate-100 select-none">

    <!-- AUDIO LATAR BELAKANG (OPENING & IN-GAME RETRO) -->
    <audio id="bgmOpening" loop preload="auto">
        <source src="https://cdn.jsdelivr.net/gh/anumukmin/game-musik@main/opening.mp3" type="audio/mpeg">
        <source src="https://raw.githubusercontent.com/anumukmin/game-musik/main/opening.mp3" type="audio/mpeg">
    </audio>
    <audio id="bgmIngame" loop preload="auto">
        <source src="https://cdn.jsdelivr.net/gh/anumukmin/game-musik@95757423faf44313f15609ac6ae501458da80b43/ingame.mp3" type="audio/mpeg">
        <source src="https://raw.githubusercontent.com/anumukmin/game-musik/95757423faf44313f15609ac6ae501458da80b43/ingame.mp3" type="audio/mpeg">
        <source src="https://raw.githubusercontent.com/anumukmin/game-musik/main/ingame.mp3" type="audio/mpeg">
    </audio>

    <!-- HALAMAN DEPAN / LOGIN IDENTITAS SISWA (ADAPTIF PORTRAIT & LANDSCAPE) -->
    <div id="start-screen" class="fixed inset-0 z-50 flex flex-col justify-between bg-slate-950 overflow-y-auto">
        <!-- Gambar Latar Ilustrasi Kecamatan Harapan -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden bg-gradient-to-b from-sky-500 via-sky-200 to-emerald-800">
            <img
                src="https://raw.githubusercontent.com/anumukmin/game-musik/2033a2a8f441c92a3591f9855e11309bfd4a020e/Gemini_Generated_Image_rxjwltrxjwltrxjw.jpg"
                onerror="this.src='https://placehold.co/1920x1080/0ea5e9/ffffff?text=KECAMATAN+HARAPAN+3D'"
                alt="Kecamatan Harapan Ekspedisi Energi Terbarukan"
                class="w-full h-full object-contain portrait:object-top landscape:object-cover"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-slate-950/40"></div>
        </div>

        <!-- Baris Atas: Identitas Mata Pelajaran & Tombol Musik -->
        <div class="relative z-10 flex items-center justify-between gap-2 p-3 sm:p-5">
            <div class="glass-panel px-3 py-1.5 sm:px-4 sm:py-2 rounded-full flex items-center gap-2 shadow-lg">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-xs sm:text-sm font-semibold text-emerald-300 tracking-wide">PROJEK IPAS SMK • ENERGI TERBARUKAN</span>
            </div>

            <button
                type="button"
                onclick="toggleMusic()"
                class="music-toggle-btn glass-panel hover:bg-slate-800 active:scale-95 transition px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-full flex items-center gap-2 text-xs sm:text-sm font-bold text-amber-300 shadow-lg cursor-pointer"
            >
                <span class="music-icon text-base">🔊</span>
                <span class="music-label">Musik: ON</span>
            </button>
        </div>

        <!-- Kartu Login Pojok Kanan Bawah (Responsif HP Portrait / Landscape & Laptop) -->
        <div class="relative z-10 w-full flex justify-center sm:justify-end items-end p-4 sm:p-8 mt-auto">
            <div class="glass-panel w-full max-w-lg sm:max-w-xl rounded-3xl p-5 sm:p-8 shadow-2xl border border-emerald-400/35">
                <div class="mb-4 sm:mb-5">
                    <span class="inline-block px-3 py-1 rounded-lg bg-emerald-500/20 text-emerald-300 text-xs sm:text-sm font-bold uppercase tracking-wider mb-1.5">
                        Simulasi Eksplorasi 3D
                    </span>
                    <h1 class="text-xl sm:text-2xl font-extrabold text-white leading-tight">
                        Registrasi Teknisi Muda Energi
                    </h1>
                    <p class="text-xs sm:text-sm text-slate-300 mt-1">
                        Bantu Pak Camat & warga 5 desa membangun pembangkit energi bersih Kecamatan Harapan!
                    </p>
                </div>

                <form id="loginForm" onsubmit="handleStartSubmit(event)" class="space-y-3.5 sm:space-y-4">
                    <div>
                        <label for="studentName" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">Nama Lengkap Siswa</label>
                        <input
                            type="text"
                            id="studentName"
                            required
                            placeholder="Contoh: Bimo Pratama"
                            class="w-full px-4 py-3 sm:py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 focus:border-emerald-400 focus:outline-none text-sm sm:text-base text-white placeholder-slate-500"
                        >
                    </div>

                    <div class="grid grid-cols-2 gap-3 sm:gap-4">
                        <div>
                            <label for="studentClass" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">Kelas</label>
                            <input
                                type="text"
                                id="studentClass"
                                required
                                placeholder="Contoh: X TKR 1"
                                class="w-full px-4 py-3 sm:py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 focus:border-emerald-400 focus:outline-none text-sm sm:text-base text-white placeholder-slate-500"
                            >
                        </div>
                        <div>
                            <label for="studentAbsen" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">No. Absen</label>
                            <input
                                type="number"
                                id="studentAbsen"
                                min="1"
                                max="60"
                                required
                                placeholder="01"
                                class="w-full px-4 py-3 sm:py-3.5 rounded-xl bg-slate-900/90 border border-slate-700 focus:border-emerald-400 focus:outline-none text-sm sm:text-base text-white placeholder-slate-500"
                            >
                        </div>
                    </div>

                    <div id="loginErrorMsg" class="hidden text-xs sm:text-sm text-rose-300 bg-rose-950/80 border border-rose-500/40 rounded-lg px-3.5 py-2.5"></div>

                    <button
                        type="submit"
                        class="w-full py-3.5 sm:py-4 px-5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 active:scale-[0.99] text-slate-950 font-extrabold text-base sm:text-lg shadow-lg shadow-emerald-500/25 transition flex items-center justify-center gap-2 cursor-pointer pulse-glow"
                    >
                        <span>🚀 Mulai Ekspedisi Energi 3D</span>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- DUNIA 3D UTAMA -->
    <div id="game-ui" class="hidden fixed inset-0">
        <div id="canvas-container"></div>

        <!-- HUD ATAS -->
        <div class="fixed top-0 left-0 right-0 z-20 p-2.5 sm:p-4 flex flex-wrap items-center justify-between gap-2 pointer-events-none">
            <!-- Info Siswa & Skor -->
            <div class="glass-panel px-3 py-2 rounded-2xl flex items-center gap-3 pointer-events-auto shadow-lg">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex items-center justify-center text-lg">
                    👷‍♂️
                </div>
                <div>
                    <div id="hudPlayerName" class="text-xs sm:text-sm font-bold text-white leading-tight">Siswa SMK</div>
                    <div class="flex items-center gap-2 text-[11px] text-slate-300">
                        <span id="hudProgress">Desa: 0/5</span>
                        <span>•</span>
                        <span id="hudScore" class="text-amber-400 font-bold">Skor: 0</span>
                    </div>
                </div>
            </div>

            <!-- Kontrol Cepat Kanan Atas -->
            <div class="flex items-center gap-1.5 sm:gap-2 pointer-events-auto">
                <button
                    type="button"
                    onclick="toggleMusic()"
                    class="music-toggle-btn glass-panel hover:bg-slate-800 px-3 py-2 rounded-xl text-xs font-bold text-amber-300 flex items-center gap-1.5 shadow-lg cursor-pointer"
                >
                    <span class="music-icon">🔊</span>
                    <span class="music-label hidden sm:inline">Musik: ON</span>
                </button>

                <button
                    type="button"
                    onclick="openReportModal()"
                    class="glass-panel hover:bg-slate-800 px-3 py-2 rounded-xl text-xs font-bold text-emerald-300 flex items-center gap-1.5 shadow-lg cursor-pointer"
                >
                    <span>📊</span>
                    <span>Laporan</span>
                </button>

                <button
                    type="button"
                    onclick="backToStartScreen()"
                    class="glass-panel hover:bg-slate-800 px-2.5 py-2 rounded-xl text-xs font-semibold text-slate-300 shadow-lg cursor-pointer"
                    title="Kembali ke Halaman Awal"
                >
                    🏠
                </button>
            </div>
        </div>

        <!-- KOMPAS TELEPORT CEPAT 5 DESA -->
        <div class="fixed top-16 sm:top-20 left-2.5 right-2.5 z-20 flex justify-center pointer-events-none">
            <div class="glass-panel px-2 py-1.5 rounded-2xl flex items-center gap-1 sm:gap-1.5 overflow-x-auto max-w-full pointer-events-auto shadow-lg">
                <button type="button" onclick="teleportTo(0, 8)" class="px-2.5 py-1 rounded-xl bg-slate-800 hover:bg-slate-700 text-[11px] font-semibold text-slate-200 whitespace-nowrap cursor-pointer">
                    🏛️ Balai Kecamatan
                </button>
                <button type="button" onclick="teleportTo(-26, 12)" id="nav-surya" class="px-2.5 py-1 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/30 text-[11px] font-semibold text-amber-200 whitespace-nowrap cursor-pointer">
                    ☀️ Desa Surya
                </button>
                <button type="button" onclick="teleportTo(25, 18)" id="nav-tirta" class="px-2.5 py-1 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/30 text-[11px] font-semibold text-sky-200 whitespace-nowrap cursor-pointer">
                    💧 Desa Tirta
                </button>
                <button type="button" onclick="teleportTo(-16, -25)" id="nav-bayu" class="px-2.5 py-1 rounded-xl bg-teal-500/20 hover:bg-teal-500/30 border border-teal-400/30 text-[11px] font-semibold text-teal-200 whitespace-nowrap cursor-pointer">
                    🌬️ Desa Bayu
                </button>
                <button type="button" onclick="teleportTo(7, 25)" id="nav-makmur" class="px-2.5 py-1 rounded-xl bg-lime-500/20 hover:bg-lime-500/30 border border-lime-400/30 text-[11px] font-semibold text-lime-200 whitespace-nowrap cursor-pointer">
                    🌱 Desa Makmur
                </button>
                <button type="button" onclick="teleportTo(24, -14)" id="nav-kawah" class="px-2.5 py-1 rounded-xl bg-orange-500/20 hover:bg-orange-500/30 border border-orange-400/30 text-[11px] font-semibold text-orange-200 whitespace-nowrap cursor-pointer">
                    🌋 Desa Kawah
                </button>
            </div>
        </div>

        <!-- PETUNJUK INTERAKSI DEKAT DESA / WARGA -->
        <div id="proximity-banner" class="hidden fixed bottom-28 sm:bottom-10 left-1/2 -translate-x-1/2 z-20 w-[92%] max-w-md">
            <div class="glass-panel p-3 sm:p-4 rounded-2xl border border-emerald-400/40 shadow-2xl flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <div id="proxBadge" class="text-[10px] font-bold uppercase tracking-wider text-emerald-300">Lokasi Terdeteksi</div>
                    <div id="proxTitle" class="text-sm font-extrabold text-white truncate">Desa Surya</div>
                    <div id="proxSub" class="text-xs text-slate-300 truncate">Klik tombol untuk memulai misi</div>
                </div>
                <button
                    type="button"
                    id="proxActionBtn"
                    class="shrink-0 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs sm:text-sm shadow-lg cursor-pointer"
                >
                    Buka Misi
                </button>
            </div>
        </div>

        <!-- PANEL DIALOG OBROLAN WARGA DESA -->
        <div id="npc-dialog-box" class="hidden fixed bottom-28 sm:bottom-8 left-1/2 -translate-x-1/2 z-30 w-[94%] max-w-lg">
            <div class="glass-panel p-4 sm:p-5 rounded-2xl border border-amber-400/50 shadow-2xl">
                <div class="flex items-start justify-between gap-3 mb-2">
                    <div class="flex items-center gap-2.5">
                        <div id="npcAvatar" class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-400/40 flex items-center justify-center text-xl">
                            🧑‍🌾
                        </div>
                        <div>
                            <h3 id="npcName" class="text-sm sm:text-base font-extrabold text-amber-300">Pak Darman</h3>
                            <p id="npcRole" class="text-[11px] text-slate-400">Warga Desa Surya</p>
                        </div>
                    </div>
                    <button type="button" onclick="closeNpcDialog()" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-300 cursor-pointer">
                        ✕
                    </button>
                </div>
                <p id="npcSpeech" class="text-xs sm:text-sm text-slate-100 leading-relaxed bg-slate-900/70 p-3 rounded-xl border border-slate-800">
                    Halo Nak! Desa kami mendapat sinar matahari terik sepanjang tahun.
                </p>
                <div class="mt-2.5 flex items-center justify-between text-[11px] text-emerald-300">
                    <span id="npcPotentialTag">💡 Potensi Utama: Energi Surya (PLTS)</span>
                    <button type="button" onclick="closeNpcDialog()" class="font-bold underline cursor-pointer">Tutup Obrolan</button>
                </div>
            </div>
        </div>

        <!-- KONTROL SENTUH D-PAD UNTUK HP / TABLET -->
        <div class="fixed bottom-4 left-4 z-20 sm:hidden">
            <div class="grid grid-cols-3 gap-1.5 w-32 h-32">
                <div></div>
                <button type="button" onpointerdown="keysPressed.up=true" onpointerup="keysPressed.up=false" onpointerleave="keysPressed.up=false" class="dpad-btn glass-panel rounded-xl flex items-center justify-center text-lg font-bold active:bg-emerald-500/40">▲</button>
                <div></div>
                <button type="button" onpointerdown="keysPressed.left=true" onpointerup="keysPressed.left=false" onpointerleave="keysPressed.left=false" class="dpad-btn glass-panel rounded-xl flex items-center justify-center text-lg font-bold active:bg-emerald-500/40">◀</button>
                <div class="rounded-xl bg-slate-900/50 border border-slate-800 flex items-center justify-center text-[10px] text-slate-400">JALAN</div>
                <button type="button" onpointerdown="keysPressed.right=true" onpointerup="keysPressed.right=false" onpointerleave="keysPressed.right=false" class="dpad-btn glass-panel rounded-xl flex items-center justify-center text-lg font-bold active:bg-emerald-500/40">▶</button>
                <div></div>
                <button type="button" onpointerdown="keysPressed.down=true" onpointerup="keysPressed.down=false" onpointerleave="keysPressed.down=false" class="dpad-btn glass-panel rounded-xl flex items-center justify-center text-lg font-bold active:bg-emerald-500/40">▼</button>
                <div></div>
            </div>
        </div>

        <div class="hidden sm:block fixed bottom-3 left-4 z-10 glass-panel px-3 py-1.5 rounded-xl text-[11px] text-slate-300 pointer-events-none">
            🎮 <b>WASD / Panah</b>: Jalan • <b>Seret Layar</b>: Putar Kamera • <b>Klik Warga</b>: Ngobrol
        </div>
    </div>

    <!-- MODAL MISI PEMBANGKIT (TAHAP 1: MATERI -> TAHAP 2: PERAKITAN + BUKTI LISTRIK -> TAHAP 3: KUIS 10 SOAL A-E) -->
    <div id="mission-modal" class="hidden fixed inset-0 z-40 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-2.5 sm:p-5 overflow-y-auto">
        <div class="glass-panel w-full max-w-3xl max-h-[92dvh] rounded-3xl border border-slate-700 shadow-2xl flex flex-col overflow-hidden">
            <!-- Header Modal -->
            <div class="p-4 sm:p-5 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between gap-3">
                <div>
                    <div id="modalVillageTag" class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">DESA SURYA • PLTS</div>
                    <h2 id="modalTitle" class="text-base sm:text-xl font-extrabold text-white">Pembangkit Listrik Tenaga Surya</h2>
                </div>
                <button type="button" onclick="closeMissionModal()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center cursor-pointer">
                    ✕
                </button>
            </div>

            <!-- Stepper Indikator Tahapan -->
            <div class="px-4 py-2.5 bg-slate-900/60 border-b border-slate-800 grid grid-cols-3 gap-2 text-center text-[11px] sm:text-xs font-bold">
                <div id="stepTab1" class="py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40">1. Materi IPAS</div>
                <div id="stepTab2" class="py-1.5 px-2 rounded-lg bg-slate-800 text-slate-400">2. Perakitan PLT</div>
                <div id="stepTab3" class="py-1.5 px-2 rounded-lg bg-slate-800 text-slate-400">3. Kuis (10 Soal)</div>
            </div>

            <!-- Isi Modal Scrollable -->
            <div class="p-4 sm:p-6 overflow-y-auto space-y-4 flex-1">
                <!-- TAHAP 1: PENDALAMAN MATERI IPAS LENGKAP -->
                <div id="stage-material" class="space-y-4">
                    <div class="p-4 rounded-2xl bg-slate-900/90 border border-slate-800 space-y-3">
                        <h3 class="text-sm sm:text-base font-extrabold text-amber-300 flex items-center gap-2">
                            <span>📘</span> Konsep Ilmiah & Prinsip Konversi Energi
                        </h3>
                        <p id="matConcept" class="text-xs sm:text-sm text-slate-200 leading-relaxed"></p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="p-4 rounded-2xl bg-sky-950/40 border border-sky-500/30 space-y-2">
                            <h4 class="text-xs sm:text-sm font-extrabold text-sky-300">📐 Rumus & Perhitungan IPAS</h4>
                            <p id="matFormula" class="text-xs sm:text-sm font-mono text-sky-100 bg-slate-950/70 p-2.5 rounded-xl"></p>
                            <p id="matFormulaDesc" class="text-xs text-slate-300 leading-relaxed"></p>
                        </div>

                        <div class="p-4 rounded-2xl bg-emerald-950/40 border border-emerald-500/30 space-y-2">
                            <h4 class="text-xs sm:text-sm font-extrabold text-emerald-300">⚙️ Komponen Utama Pembangkit</h4>
                            <ul id="matComponents" class="text-xs text-slate-200 space-y-1.5 list-disc list-inside"></ul>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-amber-950/30 border border-amber-500/30 space-y-1.5">
                        <h4 class="text-xs sm:text-sm font-extrabold text-amber-300">🌍 Analisis Potensi Lokal & Dampak Lingkungan</h4>
                        <p id="matImpact" class="text-xs sm:text-sm text-slate-200 leading-relaxed"></p>
                    </div>

                    <div class="pt-2 flex justify-end">
                        <button
                            type="button"
                            onclick="goToAssemblyStage()"
                            class="w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-sm shadow-lg transition cursor-pointer"
                        >
                            Lanjut ke Perakitan Sistem PLT →
                        </button>
                    </div>
                </div>

                <!-- TAHAP 2: PERAKITAN SISTEM & BUKTI PENGHASILAN LISTRIK -->
                <div id="stage-assembly" class="hidden space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-xs sm:text-sm text-slate-200">
                            Susun <b>4 komponen utama</b> secara berurutan dari sumber energi hingga distribusi listrik ke rumah warga:
                        </p>
                        <button type="button" onclick="showMaterialStage()" class="text-xs font-bold text-amber-300 underline cursor-pointer">
                            📘 Baca Materi Lagi
                        </button>
                    </div>

                    <!-- Slot Rangkaian 1 - 4 -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="assemblySlots"></div>

                    <!-- Pilihan Komponen Tersedia -->
                    <div class="p-3.5 rounded-2xl bg-slate-900/90 border border-slate-800">
                        <div class="text-xs font-bold text-slate-400 mb-2">Klik Komponen Secara Berurutan (Sumber Energi → Pembangkit → Distribusi):</div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="assemblyPool"></div>
                    </div>

                    <div id="assemblyFeedback" class="hidden p-3 rounded-xl text-xs sm:text-sm font-semibold"></div>

                    <!-- PANEL BUKTI TELEMETRI LISTRIK AKTIF (MUNCUL SETELAH PERAKITAN SELESAI) -->
                    <div id="builderProofBox" class="hidden p-4 rounded-2xl bg-gradient-to-br from-emerald-950/90 to-slate-900 border-2 border-emerald-400 shadow-xl space-y-3">
                        <div class="flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-emerald-400 animate-ping"></span>
                                <span class="text-xs sm:text-sm font-extrabold text-emerald-300 uppercase tracking-wide">
                                    ⚡ Bukti Sistem Aktif Menghasilkan Listrik!
                                </span>
                            </div>
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[11px] font-bold">ONLINE • 220V AC</span>
                        </div>

                        <div class="grid grid-cols-3 gap-2 text-center">
                            <div class="p-2.5 rounded-xl bg-slate-950/80 border border-emerald-500/30">
                                <div class="text-[10px] text-slate-400">Daya Keluaran</div>
                                <div id="proofPowerVal" class="text-sm sm:text-lg font-extrabold text-amber-400">12,5 kW</div>
                            </div>
