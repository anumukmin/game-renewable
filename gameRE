        function goToAssemblyStage() {
            setModalStageUI(2);
            const alreadyAssembled = !!gameState.assembledVillages[currentVillage.id];

            if (alreadyAssembled) {
                selectedAssembly = currentVillage.assemblyOrder.map(item => item.id);
                renderAssemblyUI();
                showElectricityProofPanel();
            } else {
                resetAssemblySlots();
            }
        }

        function resetAssemblySlots() {
            selectedAssembly = [];
            // Acak urutan komponen setiap kali mulai merakit agar siswa benar-benar menganalisis alur energi
            shuffledPoolOrder = [...currentVillage.assemblyOrder].sort(() => Math.random() - 0.5);
            document.getElementById('assemblyFeedback').classList.add('hidden');
            document.getElementById('builderProofBox').classList.add('hidden');
            document.getElementById('assemblyControls').classList.remove('hidden');
            renderAssemblyUI();
        }

        function renderAssemblyUI() {
            const slotsContainer = document.getElementById('assemblySlots');
            const poolContainer = document.getElementById('assemblyPool');
            slotsContainer.innerHTML = '';
            poolContainer.innerHTML = '';

            for (let i = 0; i < 4; i++) {
                const compId = selectedAssembly[i];
                const compObj = currentVillage.assemblyOrder.find(c => c.id === compId);
                const slotDiv = document.createElement('div');
                slotDiv.className = compObj
                    ? 'p-3 rounded-xl bg-emerald-500/20 border border-emerald-400 text-left'
                    : 'p-3 rounded-xl bg-slate-900/70 border border-dashed border-slate-700 text-center flex flex-col items-center justify-center min-h-[76px]';

                if (compObj) {
                    slotDiv.innerHTML = `
                        <div class="text-[10px] font-bold text-emerald-300">Urutan ${i + 1}</div>
                        <div class="text-xs font-extrabold text-white mt-0.5">${compObj.label}</div>
                    `;
                } else {
                    slotDiv.innerHTML = `<span class="text-xs font-bold text-slate-500">Slot ${i + 1}</span>`;
                }
                slotsContainer.appendChild(slotDiv);
            }

            const poolList = shuffledPoolOrder.length === 4 ? shuffledPoolOrder : currentVillage.assemblyOrder;
            poolList.forEach(item => {
                const isUsed = selectedAssembly.includes(item.id);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.disabled = isUsed || selectedAssembly.length >= 4;
                btn.className = isUsed
                    ? 'p-3 rounded-xl bg-slate-900/40 border border-slate-800 text-left opacity-40 cursor-not-allowed'
                    : 'p-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-left transition cursor-pointer';
                btn.innerHTML = `
                    <div class="text-xs font-extrabold text-amber-300">${item.label}</div>
                    <div class="text-[11px] text-slate-300 mt-0.5">${item.desc}</div>
                `;
                btn.onclick = () => {
                    if (selectedAssembly.length < 4 && !selectedAssembly.includes(item.id)) {
                        selectedAssembly.push(item.id);
                        renderAssemblyUI();
                    }
                };
                poolContainer.appendChild(btn);
            });
        }

        function verifyCircuitAssembly() {
            const fb = document.getElementById('assemblyFeedback');
            if (selectedAssembly.length < 4) {
                fb.textContent = '⚠️ Silakan pasang ke-4 komponen pembangkit listrik ke dalam slot terlebih dahulu!';
                fb.className = 'p-3 rounded-xl text-xs sm:text-sm font-semibold bg-amber-950/80 border border-amber-500/40 text-amber-200';
                fb.classList.remove('hidden');
                return;
            }

            const isCorrect = currentVillage.assemblyOrder.every((item, idx) => selectedAssembly[idx] === item.id);
            if (!isCorrect) {
                fb.textContent = '❌ Urutan aliran energi belum tepat! Periksa kembali alur dari sumber energi alami menuju generator dan distribusi.';
                fb.className = 'p-3 rounded-xl text-xs sm:text-sm font-semibold bg-rose-950/80 border border-rose-500/40 text-rose-200';
                fb.classList.remove('hidden');
                return;
            }

            // Perakitan berhasil -> munculkan pembangkit 3D + aliran listrik + panel bukti telemetri!
            fb.classList.add('hidden');
            gameState.assembledVillages[currentVillage.id] = true;
            activateVillage3DPowerPlant(currentVillage.id);
            showElectricityProofPanel();
        }

