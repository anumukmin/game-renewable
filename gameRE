        function updateMusicUI() {
            document.querySelectorAll('.music-icon').forEach(el => {
                el.textContent = gameState.musicEnabled ? '🔊' : '🔇';
            });
            document.querySelectorAll('.music-label').forEach(el => {
                el.textContent = gameState.musicEnabled ? 'Musik: ON' : 'Musik: OFF';
            });
        }

        function syncBackgroundMusic() {
            const bgmOpening = document.getElementById('bgmOpening');
            const bgmIngame = document.getElementById('bgmIngame');
            if (!bgmOpening || !bgmIngame) return;

            if (!gameState.musicEnabled) {
                bgmOpening.pause();
                bgmIngame.pause();
                return;
            }

            if (gameState.inGame) {
                bgmOpening.pause();
                bgmIngame.volume = 0.55;
                bgmIngame.play().catch(() => {});
            } else {
                bgmIngame.pause();
                bgmOpening.volume = 0.5;
                bgmOpening.play().catch(() => {});
            }
        }

        function toggleMusic() {
            gameState.musicEnabled = !gameState.musicEnabled;
            updateMusicUI();
            syncBackgroundMusic();
        }

