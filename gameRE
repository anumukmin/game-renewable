        function submitScoreToGoogleSheet(isManualClick = false) {
            const webhookUrl = getActiveSheetWebhook();
            const statusEl = document.getElementById('sheetSyncStatus');

            if (!webhookUrl) {
                if (isManualClick && statusEl) {
                    statusEl.textContent = '⚠️ Link Spreadsheet belum diatur guru';
                    statusEl.className = 'text-[11px] font-bold text-amber-300';
                }
                return;
            }

            const doneCount = Object.keys(gameState.completedVillages).length;
            const totalScore = Object.values(gameState.scores).reduce((a, b) => a + b, 0);
            const payload = {
                nama: gameState.studentName,
                kelas: gameState.studentClass,
                absen: gameState.studentAbsen,
                desaSelesai: `${doneCount}/5`,
                surya: gameState.scores.surya,
                tirta: gameState.scores.tirta,
                bayu: gameState.scores.bayu,
                makmur: gameState.scores.makmur,
                kawah: gameState.scores.kawah,
                totalSkor: totalScore
            };

            if (statusEl) {
                statusEl.textContent = '⏳ Mengirim nilai...';
                statusEl.className = 'text-[11px] font-bold text-amber-300';
            }

            fetch(webhookUrl, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            })
            .then(() => {
                if (statusEl) {
                    statusEl.textContent = '✅ Nilai Terkirim ke Spreadsheet!';
                    statusEl.className = 'text-[11px] font-bold text-emerald-400';
                }
            })
            .catch(() => {
                if (statusEl) {
                    statusEl.textContent = '❌ Gagal kirim, coba klik Kirim lagi';
                    statusEl.className = 'text-[11px] font-bold text-rose-400';
                }
            });
        }

