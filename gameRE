        }

        function renderQuizQuestion() {
            quizAnswered = false;
            const qObj = currentVillage.questions[quizIndex];
            document.getElementById('quizCounter').textContent = `Soal ${quizIndex + 1} dari ${currentVillage.questions.length}`;
            document.getElementById('quizQuestionText').textContent = qObj.q;

            const expBox = document.getElementById('quizExplanationBox');
            expBox.classList.add('hidden');

            const nextBtn = document.getElementById('quizNextBtn');
            nextBtn.classList.add('hidden');
            nextBtn.textContent = quizIndex === currentVillage.questions.length - 1 ? 'Selesaikan Misi Desa ✓' : 'Soal Berikutnya →';

            const optContainer = document.getElementById('quizOptionsContainer');
            optContainer.innerHTML = '';

            const letters = ['A', 'B', 'C', 'D', 'E'];
            qObj.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'w-full p-3 sm:p-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-left flex items-start gap-3 transition cursor-pointer';
                btn.innerHTML = `
                    <span class="w-7 h-7 shrink-0 rounded-lg bg-slate-800 border border-slate-600 flex items-center justify-center text-xs font-extrabold text-emerald-300">
                        ${letters[idx]}
                    </span>
                    <span class="text-xs sm:text-sm text-slate-100 leading-snug pt-0.5">${optText}</span>
                `;
                btn.onclick = () => selectQuizAnswer(idx, btn);
                optContainer.appendChild(btn);
            });
        }

        function selectQuizAnswer(selectedIdx, clickedBtn) {
            if (quizAnswered) return;
            quizAnswered = true;

            const qObj = currentVillage.questions[quizIndex];
            const buttons = document.getElementById('quizOptionsContainer').querySelectorAll('button');
            const isRight = selectedIdx === qObj.answer;

            if (isRight) {
                quizCorrectCount++;
            }

            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === qObj.answer) {
                    btn.className = 'w-full p-3 sm:p-3.5 rounded-xl bg-emerald-950/90 border-2 border-emerald-400 text-left flex items-start gap-3';
                } else if (idx === selectedIdx && !isRight) {
                    btn.className = 'w-full p-3 sm:p-3.5 rounded-xl bg-rose-950/90 border-2 border-rose-400 text-left flex items-start gap-3';
                } else {
                    btn.className = 'w-full p-3 sm:p-3.5 rounded-xl bg-slate-900/50 border border-slate-800 text-left flex items-start gap-3 opacity-55';
                }
            });

            const expBox = document.getElementById('quizExplanationBox');
            expBox.innerHTML = `<b>${isRight ? '✅ Jawaban Benar!' : '❌ Kurang Tepat.'}</b> ${qObj.exp}`;
            expBox.classList.remove('hidden');

            document.getElementById('quizNextBtn').classList.remove('hidden');
        }

        function nextQuizQuestion() {
            if (quizIndex < currentVillage.questions.length - 1) {
                quizIndex++;
                renderQuizQuestion();
            } else {
                const earnedScore = quizCorrectCount * 10;
                gameState.scores[currentVillage.id] = Math.max(gameState.scores[currentVillage.id], earnedScore);
                gameState.completedVillages[currentVillage.id] = true;
                updateHUD();
                closeMissionModal();
                openReportModal();
                submitScoreToGoogleSheet(false);
            }
        }

