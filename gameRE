            document.getElementById('stage-quiz').classList.toggle('hidden', stageNum !== 3);

            [1, 2, 3].forEach(n => {
                const tab = document.getElementById(`stepTab${n}`);
                if (n === stageNum) {
                    tab.className = 'py-1.5 px-2 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
                } else if (n < stageNum) {
                    tab.className = 'py-1.5 px-2 rounded-lg bg-sky-500/15 text-sky-300 border border-sky-500/30';
                } else {
                    tab.className = 'py-1.5 px-2 rounded-lg bg-slate-800 text-slate-400';
                }
            });
        }

