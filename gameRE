        const DEFAULT_SHEET_WEBHOOK_URL = "";

        function getActiveSheetWebhook() {
            const params = new URLSearchParams(window.location.search);
            const encodedFromUrl = params.get('sheet');
            if (encodedFromUrl) {
                try {
                    return atob(encodedFromUrl);
                } catch (e) {
                    return encodedFromUrl;
                }
            }
            return DEFAULT_SHEET_WEBHOOK_URL || localStorage.getItem('harapan_sheet_webhook') || '';
        }

