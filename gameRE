            siteGroup.add(activePlantGroup);
            scene.add(siteGroup);

            villageVisuals[v.id] = { constructionGroup, activePlantGroup, windowMat };
        }

        function activateVillage3DPowerPlant(villageId) {
            const vis = villageVisuals[villageId];
            if (!vis) return;
            vis.constructionGroup.visible = false;
            vis.activePlantGroup.visible = true;
            vis.windowMat.color.setHex(0xfef08a);
        }

        function init3D() {
            const container = document.getElementById('canvas-container');
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x7dd3fc);
            scene.fog = new THREE.Fog(0x7dd3fc, 45, 115);

            const isPortrait = window.innerHeight > window.innerWidth;
            camera = new THREE.PerspectiveCamera(isPortrait ? 68 : 55, window.innerWidth / window.innerHeight, 0.1, 200);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            container.innerHTML = '';
            container.appendChild(renderer.domElement);

            // Pencahayaan Matahari & Ambient
            const hemiLight = new THREE.HemisphereLight(0xffffff, 0x3f6212, 0.85);
            scene.add(hemiLight);

            const dirLight = new THREE.DirectionalLight(0xfffbeb, 0.9);
            dirLight.position.set(25, 45, 20);
            scene.add(dirLight);

            // Daratan Utama Kecamatan Harapan
            const ground = new THREE.Mesh(
                new THREE.PlaneGeometry(140, 140),
                new THREE.MeshLambertMaterial({ color: 0x4d7c0f })
            );
            ground.rotation.x = -Math.PI / 2;
            scene.add(ground);

            // Sungai Desa Tirta
            const river = new THREE.Mesh(
                new THREE.PlaneGeometry(5.5, 90),
                new THREE.MeshLambertMaterial({ color: 0x0284c7 })
            );
            river.rotation.x = -Math.PI / 2;
            river.position.set(31, 0.03, 0);
            scene.add(river);

            // Gunung Berapi Desa Kawah
            const volcano = new THREE.Mesh(
                new THREE.ConeGeometry(14, 18, 16),
                new THREE.MeshLambertMaterial({ color: 0x57534e })
            );
            volcano.position.set(34, 9, -24);
            scene.add(volcano);

            // Balai Kecamatan Pusat
            const hall = new THREE.Mesh(
                new THREE.BoxGeometry(6, 3.2, 4.5),
                new THREE.MeshLambertMaterial({ color: 0xf1f5f9 })
            );
            hall.position.set(0, 1.6, 0);
            scene.add(hall);
            const hallRoof = new THREE.Mesh(
                new THREE.ConeGeometry(4.8, 2.0, 4),
                new THREE.MeshLambertMaterial({ color: 0xb91c1c })
            );
            hallRoof.position.set(0, 4.2, 0);
            hallRoof.rotation.y = Math.PI / 4;
            scene.add(hallRoof);

            // Jaringan Jalan Raya Realistis Menuju 5 Desa
            createRoadStrip(0, 8, -26, 12, 3.0);
            createRoadStrip(0, 8, 25, 18, 3.0);
            createRoadStrip(0, 8, -16, -25, 3.0);
            createRoadStrip(0, 8, 7, 25, 3.0);
            createRoadStrip(0, 8, 24, -14, 3.0);

            // Pepohonan Teratur di Zona Ekosistem (Hutan Gunung & Tepi Sungai, Sabana Surya Tetap Terbuka)
            const treeCoords = [
                [-8, -14], [-11, -18], [-22, -20], [-24, -28],
                [16, -18], [19, -22], [28, -8], [22, -24],
                [21, 10], [28, 12], [28, 25], [18, 24],
                [-6, 18], [-12, 24], [14, 28], [2, 31]
            ];
            treeCoords.forEach(([tx, tz], idx) => createTree(tx, tz, 0.9 + (idx % 3) * 0.2));

            // Bangun 5 Lokasi Pembangkit Desa
            VILLAGES_DATA.forEach(v => {
                buildVillageSite(v);
                if (gameState.assembledVillages[v.id]) {
                    activateVillage3DPowerPlant(v.id);
                }
            });

            // Bangun 10 Warga Desa Interaktif (NPC)
            VILLAGER_NPCS.forEach(npc => {
                const npcMesh = createPersonMesh(npc.shirtColor, npc.pantsColor, false);
                npcMesh.position.set(npc.pos.x, 0, npc.pos.z);
                npcMesh.userData.npcData = npc;
                scene.add(npcMesh);
                npcInteractMeshes.push(npcMesh);
            });

            // Karakter Pemain Teknisi Muda
            playerGroup = createPersonMesh(0x10b981, 0x1e293b, true);
            playerGroup.position.set(0, 0, 8);
            scene.add(playerGroup);

            // Kontrol Keyboard & Sentuh Kamera
            window.addEventListener('keydown', e => {
                if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keysPressed.up = true;
                if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keysPressed.down = true;
                if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keysPressed.left = true;
                if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keysPressed.right = true;
            });
            window.addEventListener('keyup', e => {
                if (e.key === 'w' || e.key === 'W' || e.key === 'ArrowUp') keysPressed.up = false;
                if (e.key === 's' || e.key === 'S' || e.key === 'ArrowDown') keysPressed.down = false;
                if (e.key === 'a' || e.key === 'A' || e.key === 'ArrowLeft') keysPressed.left = false;
                if (e.key === 'd' || e.key === 'D' || e.key === 'ArrowRight') keysPressed.right = false;
            });

            let isDragging = false;
            let prevPointerX = 0;
            let prevPointerY = 0;
            const dom = renderer.domElement;

            dom.addEventListener('pointerdown', e => {
                isDragging = true;
                prevPointerX = e.clientX;
                prevPointerY = e.clientY;
            });
            window.addEventListener('pointermove', e => {
                if (!isDragging) return;
                const dx = e.clientX - prevPointerX;
                const dy = e.clientY - prevPointerY;
                prevPointerX = e.clientX;
                prevPointerY = e.clientY;
                cameraYaw -= dx * 0.007;
                cameraPitch = Math.max(0.18, Math.min(1.15, cameraPitch + dy * 0.005));
            });
            window.addEventListener('pointerup', () => {
                isDragging = false;
            });

            window.addEventListener('resize', onWindowResize);
            animate3D();
        }

        function onWindowResize() {
            if (!camera || !renderer) return;
            const isPortrait = window.innerHeight > window.innerWidth;
            camera.fov = isPortrait ? 68 : 55;
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function updateProximityInteractions() {
            if (!playerGroup) return;
            const px = playerGroup.position.x;
            const pz = playerGroup.position.z;

            // 1. Cek kedekatan dengan 5 lokasi pembangkit desa
            let nearestVillage = null;
            let minVDist = 5.6;
            for (const v of VILLAGES_DATA) {
                const dist = Math.hypot(px - v.pos.x, pz - v.pos.z);
                if (dist < minVDist) {
                    minVDist = dist;
                    nearestVillage = v;
                }
            }

            const banner = document.getElementById('proximity-banner');
            if (nearestVillage) {
                const isDone = !!gameState.completedVillages[nearestVillage.id];
                const isBuilt = !!gameState.assembledVillages[nearestVillage.id];
                document.getElementById('proxBadge').textContent = isDone
                    ? '✅ Misi Desa Selesai'
                    : isBuilt
                        ? '⚡ Pembangkit Menyala • Siap Kuis'
                        : '🛠️ Lokasi Konstruksi PLT';
                document.getElementById('proxTitle').textContent = `${nearestVillage.name} — ${nearestVillage.plantName.split(' ')[0]}`;
                document.getElementById('proxSub').textContent = isDone
                    ? `Skor: ${gameState.scores[nearestVillage.id]} Poin (Klik untuk tinjau ulang)`
                    : 'Pelajari materi IPAS, rakit pembangkit & jawab kuis';
                const btn = document.getElementById('proxActionBtn');
                btn.textContent = isDone ? 'Tinjau Misi' : 'Buka Misi';
                btn.onclick = () => openMissionModal(nearestVillage.id);
                banner.classList.remove('hidden');
                return;
            }

            // 2. Cek kedekatan dengan warga desa untuk tombol ngobrol
            let nearestNpc = null;
            let minNpcDist = 3.2;
            for (const npc of VILLAGER_NPCS) {
                const dist = Math.hypot(px - npc.pos.x, pz - npc.pos.z);
                if (dist < minNpcDist) {
                    minNpcDist = dist;
                    nearestNpc = npc;
                }
            }

            if (nearestNpc) {
                document.getElementById('proxBadge').textContent = '💬 Warga Desa';
                document.getElementById('proxTitle').textContent = nearestNpc.name;
                document.getElementById('proxSub').textContent = nearestNpc.role;
                const btn = document.getElementById('proxActionBtn');
                btn.textContent = 'Ngobrol';
                btn.onclick = () => openNpcDialog(nearestNpc);
                banner.classList.remove('hidden');
            } else {
                banner.classList.add('hidden');
            }
        }

        let walkCycleTime = 0;

        function animate3D() {
            requestAnimationFrame(animate3D);
            if (!playerGroup || !camera || !renderer) return;

            const speed = 0.16;
            let forward = 0;
            let strafe = 0;
            if (keysPressed.up) forward += 1;
            if (keysPressed.down) forward -= 1;
            if (keysPressed.left) strafe -= 1;
            if (keysPressed.right) strafe += 1;

            const isMoving = forward !== 0 || strafe !== 0;

            if (isMoving) {
                const sinY = Math.sin(cameraYaw);
                const cosY = Math.cos(cameraYaw);
                const moveX = (-sinY * forward + cosY * strafe) * speed;
                const moveZ = (-cosY * forward - sinY * strafe) * speed;

                playerGroup.position.x = Math.max(-42, Math.min(42, playerGroup.position.x + moveX));
                playerGroup.position.z = Math.max(-42, Math.min(42, playerGroup.position.z + moveZ));
                playerGroup.rotation.y = Math.atan2(moveX, moveZ);

                walkCycleTime += 0.2;
                const swing = Math.sin(walkCycleTime) * 0.55;
                const limbs = playerGroup.userData.limbs;
                if (limbs) {
                    limbs.leftLegPivot.rotation.x = swing;
                    limbs.rightLegPivot.rotation.x = -swing;
                    // Tekuk lutut secara alami saat kaki melangkah ke depan/belakang
                    limbs.leftKneePivot.rotation.x = Math.max(0, -Math.cos(walkCycleTime) * 0.55);
                    limbs.rightKneePivot.rotation.x = Math.max(0, Math.cos(walkCycleTime) * 0.55);

                    limbs.leftArmPivot.rotation.x = -swing * 0.72;
                    limbs.rightArmPivot.rotation.x = swing * 0.72;
                    // Siku sedikit menekuk alami saat berjalan
                    limbs.leftElbowPivot.rotation.x = -0.25 - Math.max(0, swing * 0.35);
                    limbs.rightElbowPivot.rotation.x = -0.25 - Math.max(0, -swing * 0.35);
                }
                playerGroup.position.y = Math.abs(Math.sin(walkCycleTime)) * 0.045;
            } else {
                const limbs = playerGroup.userData.limbs;
                if (limbs) {
                    limbs.leftLegPivot.rotation.x *= 0.8;
                    limbs.rightLegPivot.rotation.x *= 0.8;
                    limbs.leftKneePivot.rotation.x *= 0.8;
                    limbs.rightKneePivot.rotation.x *= 0.8;
                    limbs.leftArmPivot.rotation.x *= 0.8;
                    limbs.rightArmPivot.rotation.x *= 0.8;
                    limbs.leftElbowPivot.rotation.x += (-0.12 - limbs.leftElbowPivot.rotation.x) * 0.15;
                    limbs.rightElbowPivot.rotation.x += (-0.12 - limbs.rightElbowPivot.rotation.x) * 0.15;
                }
                playerGroup.position.y *= 0.8;
            }

            // Animasi putaran kincir air & turbin angin yang sudah dirakit
            animatedTurbines.forEach(item => {
                if (item.mesh.parent && item.mesh.parent.visible) {
                    item.mesh.rotation[item.axis] += item.speed;
                }
            });

            // Animasi pulsa cahaya listrik di sepanjang kabel transmisi
            electricPulses.forEach(p => {
                if (p.mesh.parent && p.mesh.parent.visible) {
                    p.t = (p.t + 0.018) % 1;
                    p.mesh.position.lerpVectors(p.start, p.end, p.t);
                }
            });

            updateProximityInteractions();

            const camX = playerGroup.position.x + Math.sin(cameraYaw) * Math.cos(cameraPitch) * cameraDistance;
            const camY = playerGroup.position.y + Math.sin(cameraPitch) * cameraDistance + 1.4;
            const camZ = playerGroup.position.z + Math.cos(cameraYaw) * Math.cos(cameraPitch) * cameraDistance;
            camera.position.set(camX, camY, camZ);
            camera.lookAt(playerGroup.position.x, playerGroup.position.y + 1.2, playerGroup.position.z);

            renderer.render(scene, camera);
        }

        window.addEventListener('load', () => {
            updateMusicUI();
            syncBackgroundMusic();
        });
    </script>
</body>
</html>
