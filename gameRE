            // Fungsi Pembantu Lengan Manusia (Bahu + Lengan Atas + Siku + Lengan Bawah + Telapak Tangan)
            function buildArm(sideSign) {
                const armPivot = new THREE.Group();
                armPivot.position.set(sideSign * 0.30, 1.42, 0);

                const shoulder = new THREE.Mesh(new THREE.SphereGeometry(0.075, 10, 10), shirtMat);
                armPivot.add(shoulder);

                const upperArm = new THREE.Mesh(new THREE.CylinderGeometry(0.068, 0.058, 0.27, 10), shirtMat);
                upperArm.position.y = -0.14;
                armPivot.add(upperArm);

                const elbowPivot = new THREE.Group();
                elbowPivot.position.set(0, -0.28, 0);

                const forearm = new THREE.Mesh(new THREE.CylinderGeometry(0.055, 0.045, 0.25, 10), skinMat);
                forearm.position.y = -0.125;
                elbowPivot.add(forearm);

                const hand = new THREE.Mesh(new THREE.SphereGeometry(0.052, 10, 10), skinMat);
                hand.scale.set(0.85, 1.15, 0.65);
                hand.position.y = -0.27;
                elbowPivot.add(hand);

                armPivot.add(elbowPivot);
                return { armPivot, elbowPivot };
            }

            const leftArmObj = buildArm(-1);
            const rightArmObj = buildArm(1);
            root.add(leftArmObj.armPivot);
            root.add(rightArmObj.armPivot);

            // Fungsi Pembantu Kaki Manusia (Paha + Lutut + Betis + Sepatu)
            function buildLeg(sideSign) {
                const legPivot = new THREE.Group();
                legPivot.position.set(sideSign * 0.115, 0.78, 0);

                const thigh = new THREE.Mesh(new THREE.CylinderGeometry(0.092, 0.075, 0.38, 12), pantsMat);
                thigh.position.y = -0.19;
                legPivot.add(thigh);

                const kneePivot = new THREE.Group();
                kneePivot.position.set(0, -0.38, 0);

                const shin = new THREE.Mesh(new THREE.CylinderGeometry(0.072, 0.058, 0.34, 12), pantsMat);
                shin.position.y = -0.17;
                kneePivot.add(shin);

                // Sepatu lengkap dengan sol depan
                const shoeHeel = new THREE.Mesh(new THREE.BoxGeometry(0.125, 0.08, 0.16), shoeMat);
                shoeHeel.position.set(0, -0.36, 0.01);
                kneePivot.add(shoeHeel);

                const shoeToe = new THREE.Mesh(new THREE.SphereGeometry(0.065, 10, 8), shoeMat);
                shoeToe.scale.set(0.95, 0.62, 1.35);
                shoeToe.position.set(0, -0.365, 0.09);
                kneePivot.add(shoeToe);

                legPivot.add(kneePivot);
                return { legPivot, kneePivot };
            }

            const leftLegObj = buildLeg(-1);
            const rightLegObj = buildLeg(1);
            root.add(leftLegObj.legPivot);
            root.add(rightLegObj.legPivot);

            root.userData.limbs = {
                headGroup,
                leftArmPivot: leftArmObj.armPivot,
                rightArmPivot: rightArmObj.armPivot,
                leftElbowPivot: leftArmObj.elbowPivot,
                rightElbowPivot: rightArmObj.elbowPivot,
                leftLegPivot: leftLegObj.legPivot,
                rightLegPivot: rightLegObj.legPivot,
                leftKneePivot: leftLegObj.kneePivot,
                rightKneePivot: rightLegObj.kneePivot
            };
            return root;
        }

        function createRoadStrip(x1, z1, x2, z2, width = 3.2) {
            const dx = x2 - x1;
            const dz = z2 - z1;
            const len = Math.hypot(dx, dz);
            const roadGroup = new THREE.Group();
            roadGroup.position.set((x1 + x2) / 2, 0.02, (z1 + z2) / 2);
            roadGroup.rotation.y = Math.atan2(dx, dz);

            // Aspal utama
            const asphalt = new THREE.Mesh(
                new THREE.PlaneGeometry(width, len),
                new THREE.MeshLambertMaterial({ color: 0x334155 })
            );
            asphalt.rotation.x = -Math.PI / 2;
            roadGroup.add(asphalt);

            // Trotoar tepi kiri & kanan
            [-width / 2 - 0.25, width / 2 + 0.25].forEach(offsetX => {
                const curb = new THREE.Mesh(
                    new THREE.BoxGeometry(0.45, 0.08, len),
                    new THREE.MeshLambertMaterial({ color: 0x94a3b8 })
                );
                curb.position.set(offsetX, 0.03, 0);
                roadGroup.add(curb);
            });

            // Marka jalan putus-putus sejajar arah jalan
            const dashCount = Math.floor(len / 2.6);
            for (let i = 0; i < dashCount; i++) {
                const dash = new THREE.Mesh(
                    new THREE.PlaneGeometry(0.16, 1.2),
                    new THREE.MeshBasicMaterial({ color: 0xfacc15 })
                );
                dash.rotation.x = -Math.PI / 2;
                dash.position.set(0, 0.015, -len / 2 + 1.3 + i * 2.6);
                roadGroup.add(dash);
            }

            // Lampu jalan teratur di tepi trotoar
            const lampCount = Math.max(1, Math.floor(len / 11));
            for (let i = 1; i <= lampCount; i++) {
                const zPos = -len / 2 + (len / (lampCount + 1)) * i;
                const poleGroup = new THREE.Group();
                poleGroup.position.set(width / 2 + 0.35, 0, zPos);

                const pole = new THREE.Mesh(
                    new THREE.CylinderGeometry(0.06, 0.08, 3.2, 8),
                    new THREE.MeshLambertMaterial({ color: 0x475569 })
                );
                pole.position.y = 1.6;
                poleGroup.add(pole);

                const arm = new THREE.Mesh(
                    new THREE.BoxGeometry(0.7, 0.06, 0.06),
                    new THREE.MeshLambertMaterial({ color: 0x475569 })
                );
                arm.position.set(-0.3, 3.15, 0);
                poleGroup.add(arm);

                const bulb = new THREE.Mesh(
                    new THREE.SphereGeometry(0.14, 8, 8),
                    new THREE.MeshBasicMaterial({ color: 0xfef08a })
                );
                bulb.position.set(-0.6, 3.1, 0);
                poleGroup.add(bulb);

                roadGroup.add(poleGroup);
            }

            scene.add(roadGroup);
        }

