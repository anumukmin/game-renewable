        function handleStartSubmit(e) {
            e.preventDefault();
            const nameVal = document.getElementById('studentName').value.trim();
            const classVal = document.getElementById('studentClass').value.trim();
            const absenVal = document.getElementById('studentAbsen').value.trim();
            const errBox = document.getElementById('loginErrorMsg');

            if (!nameVal || !classVal || !absenVal) {
                errBox.textContent = 'Mohon lengkapi Nama Lengkap, Kelas, dan Nomor Absen terlebih dahulu.';
                errBox.classList.remove('hidden');
                return;
            }

            errBox.classList.add('hidden');
            gameState.studentName = nameVal;
            gameState.studentClass = classVal;
            gameState.studentAbsen = absenVal;
            gameState.inGame = true;

            document.getElementById('hudPlayerName').textContent = `${nameVal} (${classVal} • No.${absenVal})`;
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('game-ui').classList.remove('hidden');

            // Putar musik in-game secara sinkron dalam event user gesture
            const bgmOpening = document.getElementById('bgmOpening');
            const bgmIngame = document.getElementById('bgmIngame');
            if (bgmOpening) bgmOpening.pause();
            if (bgmIngame && gameState.musicEnabled) {
                bgmIngame.currentTime = 0;
                bgmIngame.volume = 0.6;
                bgmIngame.play().catch(() => {});
            }

            if (!renderer) {
                init3D();
            } else {
                onWindowResize();
            }
        }

